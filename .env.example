# Variables de entorno — OpenXixón
# Copia este fichero a .env y rellena con tus credenciales reales.
# Las variables PUBLIC_* se exponen al navegador.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# URL del proyecto (visible en Settings → API)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Clave anónima (pública, segura de exponer al cliente)
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave de servicio (SECRETO — nunca la expongas al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (opcional) ─────────────────────────────────────────────────────────
# Solo necesario si usas Stripe como pasarela de pago
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ─── LemonSqueezy (opcional, alternativa a Stripe) ────────────────────────────
# Solo necesario si usas LemonSqueezy como pasarela de pago
# LEMONSQUEEZY_API_KEY=...
# LEMONSQUEEZY_STORE_ID=...
# LEMONSQUEEZY_WEBHOOK_SECRET=...

# ─── SMTP (alertas por email) ─────────────────────────────────────────────────
# Configura tu servidor SMTP local o externo. La Edge Function llama al endpoint
# interno /api/internal/send-email que usa estos datos para enviar vía nodemailer.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=alertas@openxixon.vodtinker.dev
# SMTP_SECURE=false
# SMTP_REJECT_UNAUTHORIZED=true

# ─── Seguridad interna ─────────────────────────────────────────────────────────
# Token compartido entre la Edge Function y el endpoint /api/internal/send-email.
# Genera uno aleatorio largo (openssl rand -hex 32) y pon el mismo en Supabase Secrets.
# INTERNAL_API_SECRET=generar_con_openssl_rand_hex_32
