---
import Layout from '../layouts/Layout.astro'
import EmptyState from '../components/EmptyState.astro'
import { db, getSession } from '../lib/supabase'
import type { Plan } from '../lib/tier'

const { user } = await getSession(Astro.cookies, Astro.request)
let plan: Plan = 'free'
if (user) {
  const { data: profile } = await db.from('profiles').select('plan').eq('user_id', user.id).single()
  plan = (profile?.plan as Plan) ?? 'free'
}

let errorMessage: string | null = null
let inversionesData: any[] | null = null

try {
  const { data } = await db
    .from('inversiones').select('*')
    .order('fecha_adjudicacion', { ascending: false, nullsFirst: false })
    .limit(2000)
  inversionesData = data
} catch (e) {
  console.error('[SSR /inversiones]', e)
  errorMessage = 'No se pudieron cargar las inversiones. Inténtalo más tarde.'
}

const inversiones = inversionesData ?? []

// ── Métricas resumen ─────────────────────────────────────────────────────
const totalPresupuestado  = inversiones.reduce((s, r) => s + (Number(r.importe_presupuestado) || 0), 0)
const totalAdjudicado     = inversiones.reduce((s, r) => s + (Number(r.importe_adjudicacion) || 0), 0)
const conCoords           = inversiones.filter(r => r.latitud && r.longitud).length

// ── Agregaciones para filtros ────────────────────────────────────────────
const estadosCount: Record<string, number> = {}
const entidadesCount: Record<string, number> = {}
for (const inv of inversiones) {
  if (inv.estado_actual) estadosCount[inv.estado_actual] = (estadosCount[inv.estado_actual] ?? 0) + 1
  if (inv.entidad)       entidadesCount[inv.entidad]     = (entidadesCount[inv.entidad]     ?? 0) + 1
}
const topEstados   = Object.entries(estadosCount).sort((a, b) => b[1] - a[1]).slice(0, 6)
const topEntidades = Object.entries(entidadesCount).sort((a, b) => b[1] - a[1])

// ── Top inversiones por importe presupuestado ────────────────────────────
const topImportes = [...inversiones]
  .filter(r => r.importe_presupuestado)
  .sort((a, b) => Number(b.importe_presupuestado) - Number(a.importe_presupuestado))
  .slice(0, 25)

const fmtEUR = (n: number | string | null) => {
  const v = typeof n === 'string' ? Number(n) : n
  if (!v || !Number.isFinite(v)) return '—'
  return v.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 })
}

const fmtFecha = (s: string | null) => {
  if (!s) return '—'
  const d = new Date(s)
  return Number.isNaN(d.getTime()) ? '—' : new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).format(d)
}

const estadoColor = (e: string | null) => {
  switch (e) {
    case 'Finalización':  return 'status--ok'
    case 'Ejecución':     return 'status--exec'
    case 'Adjudicación':  return 'status--adj'
    case 'Licitación':    return 'status--lic'
    case 'Aprobación':    return 'status--apr'
    case 'Paralización':  return 'status--bad'
    default:              return ''
  }
}
---

<Layout title="Inversiones Municipales">
  <div class="container">
    <header class="page-header">
      <div>
        <span class="label label-amber">Datos financieros</span>
        <h1>Inversiones Municipales</h1>
        <p>Obras, contratos y proyectos del Ayuntamiento de Gijón y entidades dependientes (EMULSA, EMASA, FMCEUP).</p>
      </div>
      <span class="badge" class:list={[plan === 'free' ? 'badge-free' : 'badge-pro']}>{plan.toUpperCase()}</span>
    </header>

    {errorMessage && (
      <EmptyState message={errorMessage} />
    )}

    {!errorMessage && (
    <>
    <!-- Métricas resumen -->
    <section class="data-section">
      <div class="metrics-row">
        <div class="metric-cell">
          <span class="metric-label mono">INVERSIONES</span>
          <div class="metric-main">
            <span class="metric-val mono">{inversiones.length.toLocaleString('es-ES')}</span>
          </div>
          <span class="calidad-tag">registros</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label mono">PRESUPUESTADO</span>
          <div class="metric-main">
            <span class="metric-val mono" style="color:#E2A66E; font-size:1.5rem">{fmtEUR(totalPresupuestado)}</span>
          </div>
          <span class="calidad-tag">total acumulado</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label mono">ADJUDICADO</span>
          <div class="metric-main">
            <span class="metric-val mono" style="color:#00DB7C; font-size:1.5rem">{fmtEUR(totalAdjudicado)}</span>
          </div>
          <span class="calidad-tag">contratado</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label mono">GEORREFERENCIADAS</span>
          <div class="metric-main">
            <span class="metric-val mono">{conCoords}</span>
          </div>
          <span class="calidad-tag">con lat/long</span>
        </div>
      </div>
    </section>

    <!-- Distribución por estado -->
    <section class="data-section">
      <span class="label">Distribución por estado</span>
      {topEstados.length > 0 ? (
        <div class="chips-row">
          {topEstados.map(([estado, n]) => (
            <div class="chip" class:list={[estadoColor(estado)]}>
              <span class="chip-label">{estado}</span>
              <span class="chip-val mono">{n}</span>
            </div>
          ))}
        </div>
      ) : (
        <EmptyState message="Sin datos de estado disponibles." />
      )}
    </section>

    <!-- Entidades -->
    <section class="data-section">
      <span class="label">Entidades</span>
      {topEntidades.length > 0 ? (
        <div class="chips-row">
          {topEntidades.map(([entidad, n]) => (
            <div class="chip">
              <span class="chip-label mono">{entidad}</span>
              <span class="chip-val mono">{n}</span>
            </div>
          ))}
        </div>
      ) : (
        <EmptyState message="Sin datos de entidades disponibles." />
      )}
    </section>

    <!-- Top inversiones por importe -->
    <section class="data-section">
      <span class="label">Inversiones de mayor cuantía</span>
      {topImportes.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Cód.</th>
                <th>Objeto</th>
                <th>Entidad</th>
                <th>Estado</th>
                <th>Adjudicado</th>
                <th>Presupuesto</th>
                <th>F. adjudicación</th>
              </tr>
            </thead>
            <tbody>
              {topImportes.map(inv => (
                <tr>
                  <td class="mono code-cell">{inv.codigo}</td>
                  <td class="objeto-cell" title={inv.descripcion ?? inv.objeto ?? ''}>{inv.objeto ?? '—'}</td>
                  <td><span class="entidad-tag mono">{inv.entidad ?? '—'}</span></td>
                  <td class:list={[estadoColor(inv.estado_actual), 'mono', 'estado-cell']}>{inv.estado_actual ?? '—'}</td>
                  <td class="amount income mono">{fmtEUR(inv.importe_adjudicacion)}</td>
                  <td class="amount mono">{fmtEUR(inv.importe_presupuestado)}</td>
                  <td class="mono fecha-cell">{fmtFecha(inv.fecha_adjudicacion)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <EmptyState message="Sin inversiones con importe presupuestado registrado." />
      )}
    </section>

    <!-- API link -->
    <section class="api-link-section">
      <div class="api-link-bar">
        <div>
          <strong>API de Inversiones</strong>
          <span style="color:var(--text-muted); font-size:0.8125rem; margin-left:0.5rem">
            Acceso programático · {plan === 'free' ? '30 días de histórico' : '1 año'}
          </span>
        </div>
        <a href="/docs" class="btn btn-secondary btn-sm">Ver docs →</a>
      </div>
    </section>
    </>
    )}
  </div>
</Layout>

<style>
  .page-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);
  }
  .page-header h1 { margin: 0.75rem 0 0.4rem; }
  .page-header p  { font-size: 0.9375rem; }

  .data-section { margin-bottom: 3rem; }
  .data-section > .label { display: block; margin-bottom: 1rem; }

  /* Metrics */
  .metrics-row {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border); overflow: hidden;
  }
  .metric-cell {
    padding: 1.25rem; border-right: 1px solid var(--border);
    background: var(--surface); display: flex; flex-direction: column; gap: 0.5rem;
  }
  .metric-cell:last-child { border-right: none; }
  .metric-label { font-size: 0.625rem; color: var(--text-muted); letter-spacing: 0.04em; }
  .metric-main  { display: flex; align-items: baseline; gap: 0.4rem; }
  .metric-val   { font-size: 2rem; font-weight: 500; line-height: 1; }
  .calidad-tag  { font-size: 0.625rem; color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.05em; }

  /* Chips */
  .chips-row {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .chip {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.5rem 0.875rem; border: 1px solid var(--border); background: var(--surface);
    font-size: 0.8125rem;
  }
  .chip-label { color: var(--text-dim); }
  .chip-val { color: var(--text); font-weight: 600; }

  /* Tabla */
  .code-cell    { font-size: 0.6875rem; color: var(--text-muted); white-space: nowrap; }
  .objeto-cell  { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
  .entidad-tag  { font-size: 0.6875rem; padding: 0.15rem 0.45rem; background: var(--surface-2); color: var(--text-dim); }
  .estado-cell  { font-size: 0.75rem; }
  .fecha-cell   { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; }
  .amount       { font-weight: 600; font-size: 0.8125rem; }
  .amount.income { color: var(--sage); }

  .status--ok    { color: var(--sage); }
  .status--exec  { color: var(--amber); }
  .status--adj   { color: var(--accent); }
  .status--lic   { color: #8AD6FF; }
  .status--apr   { color: #D1B8FF; }
  .status--bad   { color: var(--brick); }

  .api-link-section { margin-bottom: 2rem; }
  .api-link-bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 1rem 1.25rem;
    border: 1px solid var(--border); background: var(--surface);
    flex-wrap: wrap;
  }
  .api-link-bar strong { font-size: 0.875rem; }

  @media (max-width: 768px) {
    .page-header { flex-direction: column; gap: 1rem; }
    .metrics-row { grid-template-columns: repeat(2, 1fr); }
    .metric-cell:nth-child(2) { border-right: none; }
    .metric-cell:nth-child(1),
    .metric-cell:nth-child(2) { border-bottom: 1px solid var(--border); }
    .objeto-cell { max-width: 180px; }
    .api-link-bar { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) {
    .metrics-row { grid-template-columns: 1fr; }
    .metric-cell { border-right: none; border-bottom: 1px solid var(--border); }
    .metric-cell:last-child { border-bottom: none; }
  }
</style>
