---
import Layout from '../layouts/Layout.astro'
import IncidenciasChart from '../components/charts/IncidenciasChart'
import { db } from '../lib/supabase'
import { getSession } from '../lib/supabase'
import { getDateFilter } from '../lib/tier'
import type { Plan } from '../lib/tier'

const { user } = await getSession(Astro.cookies, Astro.request)
let plan: Plan = 'free'
if (user) {
  const { data: profile } = await db.from('profiles').select('plan').eq('user_id', user.id).single()
  plan = (profile?.plan as Plan) ?? 'free'
}

const dateFilter = getDateFilter(plan).split('T')[0]

let errorMessage: string | null = null
let incidencias: any[] | null = null

try {
  const { data } = await db
    .from('incidencias_urbanas')
    .select('*')
    .gte('fecha', dateFilter)
    .order('fecha', { ascending: false })
    .limit(1000)
  incidencias = data
} catch (e) {
  console.error('[SSR /incidencias]', e)
  errorMessage = 'No se pudieron cargar las incidencias. Inténtalo más tarde.'
}

const rows = incidencias ?? []
const total = rows.length
const resueltas = rows.filter(r =>
  r.estado?.toLowerCase().includes('cerrad') || r.estado?.toLowerCase().includes('resuelt')
).length
const abiertas = total - resueltas
const pctResueltas = total > 0 ? Math.round((resueltas / total) * 100) : 0
const ultimaFecha = rows[0]?.fecha ?? null

const porTipo: Record<string, number> = {}
rows.forEach(r => { porTipo[r.tipo ?? 'Otros'] = (porTipo[r.tipo ?? 'Otros'] ?? 0) + 1 })
const tiposOrdenados = Object.entries(porTipo).sort((a, b) => b[1] - a[1])

const mapPoints = rows
  .filter(r => r.latitud != null && r.longitud != null)
  .map(r => ({
    lat:    r.latitud as number,
    lon:    r.longitud as number,
    tipo:   r.tipo ?? 'N/D',
    estado: r.estado ?? 'N/D',
    fecha:  r.fecha ?? '',
    ok:     !!(r.estado?.toLowerCase().includes('cerrad') || r.estado?.toLowerCase().includes('resuelt')),
  }))

const isFree = plan === 'free'

const metricCards = [
  { label: 'Total',        val: total.toLocaleString('es-ES'), unit: '', color: '#D1B8FF', tag: 'incidencias',  pct: null },
  { label: 'Abiertas',     val: abiertas.toLocaleString('es-ES'), unit: '', color: '#E2A66E', tag: 'pendientes', pct: total > 0 ? Math.round((abiertas / total) * 100) : 0 },
  { label: 'Resueltas',    val: pctResueltas + '%', unit: '', color: '#00DB7C', tag: 'del total', pct: pctResueltas },
  ...(ultimaFecha ? [{ label: 'Última fecha', val: ultimaFecha, unit: '', color: '#8AD6FF', tag: 'en el dataset', pct: null }] : []),
]
---

<Layout title="Incidencias Urbanas">
  <div class="container">
    <header class="page-header">
      <div>
        <span class="label label-lavender">Urbanismo</span>
        <h1>Incidencias Urbanas</h1>
        <p>Incidencias reportadas en Gijón vía Cuida Gijón. Actualización diaria.</p>
      </div>
      <span class="badge" class:list={[plan === 'free' ? 'badge-free' : 'badge-pro']}>{plan.toUpperCase()}</span>
    </header>

    {errorMessage && (
      <div class="tier-notice" style="border-color:var(--brick); background:color-mix(in srgb, var(--brick) 10%, transparent)">
        <p>{errorMessage}</p>
      </div>
    )}

    {isFree && !errorMessage && (
      <div class="tier-notice">
        <p>Histórico limitado a 30 días. Próximamente: acceso completo con planes Pro.</p>
      </div>
    )}

    {!errorMessage && (
    <>
    <!-- Métricas -->
    <section class="data-section">
      <div class="section-head">
        <span class="label">Resumen</span>
      </div>
      <div class="metrics-row" style={`grid-template-columns: repeat(${metricCards.length}, 1fr)`}>
        {metricCards.map(m => (
          <div class="metric-cell">
            <span class="metric-label mono">{m.label}</span>
            <div class="metric-main">
              <span class="metric-val mono" style={"color:" + m.color}>{m.val}</span>
              {m.unit && <span class="metric-unit">{m.unit}</span>}
            </div>
            <div class="metric-bar">
              <div class="metric-fill" style={"width:" + (m.pct !== null ? m.pct : 100) + "%; background:" + m.color}></div>
            </div>
            <span class="calidad-tag">{m.tag}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Mapa -->
    {mapPoints.length > 0 && (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Mapa de incidencias</span>
          <span class="mono ts">{mapPoints.length} puntos</span>
        </div>
        <div class="map-card">
          <div id="map-inci"></div>
          <div class="map-legend">
            <span class="legend-dot" style="background:#E2A66E"></span><span class="mono">Abierta</span>
            <span class="legend-dot" style="background:#00DB7C; margin-left:1rem"></span><span class="mono">Resuelta</span>
          </div>
        </div>
      </section>
    )}

    <!-- Gráfico por categoría -->
    {tiposOrdenados.length > 0 && (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Por categoría</span>
        </div>
        <IncidenciasChart data={tiposOrdenados.map(([label, value]) => ({ label, value }))} client:only="react" />
      </section>
    )}

    <!-- Tabla -->
    {rows.length > 0 ? (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Historial</span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Código</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Fecha</th>
              </tr>
            </thead>
            <tbody>
              {rows.slice(0, 200).map(r => (
                <tr>
                  <td class="mono" style="font-size:0.75rem; color:var(--text-muted)">{r.codigo}</td>
                  <td>{r.tipo ?? '—'}</td>
                  <td>
                    <span class:list={['estado-tag',
                      r.estado?.toLowerCase().includes('cerrad') || r.estado?.toLowerCase().includes('resuelt')
                        ? 'estado-ok' : 'estado-open'
                    ]}>{r.estado ?? '—'}</span>
                  </td>
                  <td class="mono" style="font-size:0.8125rem">{r.fecha}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <div class="tier-notice">
        <p>No hay incidencias disponibles en la ventana de tu plan. Los datos se actualizan diariamente.</p>
      </div>
    )}
    </>
    )}
  </div>
</Layout>

<script type="application/json" id="inci-mapdata" set:html={JSON.stringify(mapPoints)}></script>

<script>
import maplibregl from 'maplibre-gl'
import 'maplibre-gl/dist/maplibre-gl.css'

let mapInstance: maplibregl.Map | null = null

function initMap() {
  const mapEl = document.getElementById('map-inci')
  const rawMap = document.getElementById('inci-mapdata')
  if (!mapEl || !rawMap) return

  if (mapInstance) { mapInstance.remove(); mapInstance = null }

  const points: Array<{ lat: number; lon: number; tipo: string; estado: string; fecha: string; ok: boolean }> =
    JSON.parse(rawMap.textContent!)

  mapInstance = new maplibregl.Map({
    container: mapEl,
    style: 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json',
    center: [-5.6618, 43.5452],
    zoom: 13,
    scrollZoom: false,
    attributionControl: { compact: true },
  })

  mapInstance.addControl(new maplibregl.NavigationControl(), 'top-right')

  const geojson: GeoJSON.FeatureCollection = {
    type: 'FeatureCollection',
    features: points.map(p => ({
      type: 'Feature',
      geometry: { type: 'Point', coordinates: [p.lon, p.lat] },
      properties: { ...p },
    })),
  }

  mapInstance.on('load', () => {
    mapInstance!.addSource('points', { type: 'geojson', data: geojson })

    mapInstance!.addLayer({
      id: 'points-glow',
      type: 'circle',
      source: 'points',
      paint: {
        'circle-radius': 10,
        'circle-color': ['case', ['boolean', ['get', 'ok'], false], '#00DB7C', '#E2A66E'],
        'circle-opacity': 0.15,
      },
    })

    mapInstance!.addLayer({
      id: 'points-core',
      type: 'circle',
      source: 'points',
      paint: {
        'circle-radius': 4,
        'circle-color': ['case', ['boolean', ['get', 'ok'], false], '#00DB7C', '#E2A66E'],
        'circle-opacity': 0.9,
        'circle-stroke-width': 1,
        'circle-stroke-color': ['case', ['boolean', ['get', 'ok'], false], '#00DB7C', '#E2A66E'],
      },
    })

    mapInstance!.on('click', 'points-core', (e) => {
      const f = e.features![0]
      const p = f.properties!
      new maplibregl.Popup({ offset: 8, closeButton: false })
        .setLngLat(e.lngLat)
        .setHTML(`<div style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;background:#111;border:1px solid #333;color:#e8e8e8;padding:8px 12px;box-shadow:0 4px 20px rgba(0,0,0,.7)"><div style="font-weight:600;margin-bottom:4px">${p.tipo}</div><div style="opacity:0.8">${p.estado}</div><div style="opacity:0.5;font-size:0.65rem;margin-top:4px">${p.fecha}</div></div>`)
        .addTo(mapInstance!)
    })

    mapInstance!.on('mouseenter', 'points-core', () => {
      mapInstance!.getCanvas().style.cursor = 'pointer'
    })
    mapInstance!.on('mouseleave', 'points-core', () => {
      mapInstance!.getCanvas().style.cursor = ''
    })
  })
}

document.addEventListener('astro:page-load', () => requestAnimationFrame(initMap))
</script>

<style>
  .container { max-width: var(--container-max); margin: 0 auto; padding: 2rem var(--gutter); }

  .page-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);
  }
  .page-header h1 { margin: 0.75rem 0 0.4rem; }
  .page-header p  { font-size: 0.9375rem; color: var(--text-muted); margin: 0; }

  .tier-notice {
    padding: 0.75rem 1rem; border: 1px dashed var(--amber-dim);
    margin-bottom: 2.5rem; background: var(--amber-faint);
  }
  .tier-notice p { font-size: 0.8125rem; color: var(--text-dim); margin: 0; }
  .tier-notice a { color: var(--amber); text-decoration: underline; }

  .data-section { margin-bottom: 3rem; }
  .section-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;
  }
  .ts { font-size: 0.6875rem; color: var(--text-muted); }

  .metrics-row {
    display: grid;
    border: 1px solid var(--border); overflow: hidden;
  }
  .metric-cell {
    padding: 1.25rem; border-right: 1px solid var(--border);
    background: var(--surface); display: flex; flex-direction: column; gap: 0.5rem;
  }
  .metric-cell:last-child { border-right: none; }
  .metric-label { font-size: 0.625rem; color: var(--text-muted); letter-spacing: 0.04em; }
  .metric-main  { display: flex; align-items: baseline; gap: 0.4rem; }
  .metric-val   { font-size: 2rem; font-weight: 500; line-height: 1; }
  .metric-unit  { font-size: 0.6875rem; color: var(--text-muted); }
  .metric-bar   { height: 2px; background: var(--border); overflow: hidden; }
  .metric-fill  { height: 100%; transition: width 0.4s; }
  .calidad-tag  { font-size: 0.625rem; color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.05em; }

  /* Mapa */
  .map-card {
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }
  #map-inci {
    height: 420px;
    width: 100%;
  }
  .map-legend {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.625rem; color: var(--text-muted);
    border-top: 1px solid var(--border);
    background: var(--surface);
    letter-spacing: 0.05em;
    font-family: 'IBM Plex Mono', monospace;
  }
  .legend-dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  }

  .chart-card {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.25rem;
  }

  .label { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .label-lavender { color: var(--lavender); }
  .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; border: 1px solid var(--border); color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; }
  .badge-free { color: var(--text-muted); }
  .badge-pro  { color: var(--lavender); border-color: color-mix(in srgb, var(--lavender) 45%, transparent); }

  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  th { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--text); }
  tr:last-child td { border-bottom: none; }
  .estado-tag { display: inline-block; padding: 0.1rem 0.4rem; font-size: 0.6875rem; border: 1px solid; }
  .estado-ok   { color: var(--mint);  border-color: color-mix(in srgb, var(--mint)  40%, transparent); }
  .estado-open { color: var(--amber); border-color: color-mix(in srgb, var(--amber) 40%, transparent); }

  /* MapLibre overrides */
  :global(.maplibregl-popup-content-wrapper) {
    border-radius: 0 !important;
    background: #111 !important;
    border: 1px solid #333 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,.7) !important;
  }
  :global(.maplibregl-popup-content) {
    padding: 0 !important;
    margin: 0 !important;
  }
  :global(.maplibregl-popup-tip) { display: none; }
  :global(.maplibregl-popup-close-button) { color: #888 !important; }
  :global(.maplibregl-ctrl-group button) {
    background: #111 !important; color: #ccc !important;
    border-color: #333 !important; border-radius: 0 !important;
  }
  :global(.maplibregl-ctrl-group button:hover) { background: #222 !important; color: #fff !important; }
  :global(.maplibregl-ctrl-attrib) {
    background: rgba(0,0,0,.6) !important; color: #555 !important; font-size: 0.55rem !important;
  }
  :global(.maplibregl-ctrl-attrib a) { color: #666 !important; }

  @media (max-width: 768px) {
    .page-header { flex-direction: column; gap: 1rem; }
    .metrics-row { grid-template-columns: repeat(2, 1fr) !important; }
    .metric-cell:nth-child(2n) { border-right: none; }
    .metric-cell:not(:nth-last-child(-n+2)) { border-bottom: 1px solid var(--border); }
    #map-inci { height: 320px; }
  }
  @media (max-width: 480px) {
    .metrics-row { grid-template-columns: 1fr !important; }
    .metric-cell { border-right: none; border-bottom: 1px solid var(--border); }
    .metric-cell:last-child { border-bottom: none; }
    .metric-val { font-size: 1.5rem !important; }
    #map-inci { height: 260px; }
  }
</style>
