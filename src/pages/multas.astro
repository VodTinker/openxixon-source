---
import Layout from '../layouts/Layout.astro'
import MultasChart from '../components/charts/MultasChart'
import { db } from '../lib/supabase'
import { getSession } from '../lib/supabase'
import type { Plan } from '../lib/tier'

const { user } = await getSession(Astro.cookies, Astro.request)
let plan: Plan = 'free'
if (user) {
  const { data: profile } = await db.from('profiles').select('plan').eq('user_id', user.id).single()
  plan = (profile?.plan as Plan) ?? 'free'
}

let errorMessage: string | null = null
let totalCount: number | null = null
let muestra: any[] | null = null

try {
  const { count } = await db.from('multas_trafico').select('*', { count: 'exact', head: true })
  totalCount = count
} catch (e) {
  console.error('[SSR /multas] count', e)
  errorMessage = 'No se pudieron cargar los datos de multas. Inténtalo más tarde.'
}

try {
  const { data } = await db
    .from('multas_trafico')
    .select('calificacion, importe, anio, tipo, latitud, longitud, infraccion')
    .limit(5000)
  muestra = data
} catch (e) {
  console.error('[SSR /multas] muestra', e)
  errorMessage = 'No se pudieron cargar los datos de multas. Inténtalo más tarde.'
}

const rows = muestra ?? []
const total = totalCount ?? 0
const importeTotal = rows.reduce((s, r) => s + (r.importe ?? 0), 0)
const importeMedio = rows.length > 0 ? Math.round(importeTotal / rows.length) : 0

const porCalif: Record<string, number> = {}
rows.forEach(r => { porCalif[r.calificacion ?? 'N/A'] = (porCalif[r.calificacion ?? 'N/A'] ?? 0) + 1 })
const pctLeve     = rows.length > 0 ? Math.round(((porCalif['Leve']      ?? 0) / rows.length) * 100) : 0
const pctGrave    = rows.length > 0 ? Math.round(((porCalif['Grave']     ?? 0) / rows.length) * 100) : 0
const pctMuyGrave = rows.length > 0 ? Math.round(((porCalif['Muy Grave'] ?? 0) / rows.length) * 100) : 0

// ── Gráfico por calificación ──
const porCalifGraf: Record<string, number> = {}
rows.forEach(r => { porCalifGraf[r.calificacion ?? 'N/A'] = (porCalifGraf[r.calificacion ?? 'N/A'] ?? 0) + 1 })
const califEntries = Object.entries(porCalifGraf).sort((a, b) => b[1] - a[1])

// ── Gráfico por rango de importe ──
const importeBuckets: Record<string, number> = {}
rows.forEach(r => {
  const imp = r.importe ?? 0
  if (imp <= 0) return
  let bucket = '1-50€'
  if (imp >= 300) bucket = '300€+'
  else if (imp >= 200) bucket = '200-300€'
  else if (imp >= 100) bucket = '100-200€'
  else if (imp >= 50) bucket = '50-100€'
  importeBuckets[bucket] = (importeBuckets[bucket] ?? 0) + 1
})
const bucketOrder = ['1-50€', '50-100€', '100-200€', '200-300€', '300€+']
const importeEntries = Object.entries(importeBuckets)
  .sort((a, b) => bucketOrder.indexOf(a[0]) - bucketOrder.indexOf(b[0]))

const califChartData = califEntries.map(([label, value]) => ({ label, value }))
const importeChartData = importeEntries.map(([label, value]) => ({ label, value }))

const califColor: Record<string, string> = { 'Leve': '#00DB7C', 'Grave': '#E2A66E', 'Muy Grave': '#ff6b6b' }

const mapPoints = rows
  .filter(r => r.latitud != null && r.longitud != null)
  .map(r => ({
    lat:    r.latitud as number,
    lon:    r.longitud as number,
    tipo:   r.tipo ?? 'N/D',
    calif:  r.calificacion ?? 'N/D',
    importe: r.importe ?? 0,
    color:  califColor[r.calificacion ?? ''] ?? '#8AD6FF',
  }))

const metricCards = [
  { label: 'Total registros', val: (total ?? 0).toLocaleString('es-ES'), unit: '',  color: '#E2A66E', tag: '2015–2018',   pct: null },
  { label: 'Importe medio',   val: importeMedio,                          unit: '€', color: '#8AD6FF', tag: 'por denuncia', pct: null },
  { label: 'Leves',           val: pctLeve + '%',                         unit: '',  color: '#00DB7C', tag: 'del total',   pct: pctLeve },
  { label: 'Graves',          val: pctGrave + '%',                        unit: '',  color: '#E2A66E', tag: 'del total',   pct: pctGrave },
  { label: 'Muy Graves',      val: pctMuyGrave + '%',                     unit: '',  color: '#ff6b6b', tag: 'del total',   pct: pctMuyGrave },
]
---

<Layout title="Multas de Tráfico">
  <div class="container">
    <header class="page-header">
      <div>
        <span class="label label-amber">Seguridad Vial</span>
        <h1>Multas de Tráfico</h1>
        <p>Denuncias de la Policía Local de Gijón. Datos históricos 2015–2018.</p>
      </div>
      <span class="badge" class:list={[plan === 'free' ? 'badge-free' : 'badge-pro']}>{plan.toUpperCase()}</span>
    </header>

    {errorMessage && (
      <div class="tier-notice" style="border-color:var(--brick); background:color-mix(in srgb, var(--brick) 10%, transparent)">
        <p>{errorMessage}</p>
      </div>
    )}

    {!errorMessage && (
    <>
    <!-- Métricas -->
    <section class="data-section">
      <div class="section-head">
        <span class="label">Resumen</span>
      </div>
      <div class="metrics-row">
        {metricCards.map(m => (
          <div class="metric-cell">
            <span class="metric-label mono">{m.label}</span>
            <div class="metric-main">
              <span class="metric-val mono" style={"color:" + m.color}>{m.val}</span>
              {m.unit && <span class="metric-unit">{m.unit}</span>}
            </div>
            <div class="metric-bar">
              <div class="metric-fill" style={"width:" + (m.pct !== null ? m.pct : 100) + "%; background:" + m.color}></div>
            </div>
            <span class="calidad-tag">{m.tag}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Gráficos -->
    {califChartData.length > 0 && (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Por calificación</span>
        </div>
        <MultasChart data={califChartData} color="#E2A66E" client:only="react" />
      </section>
    )}

    {importeChartData.length > 0 && (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Por rango de importe</span>
        </div>
        <MultasChart data={importeChartData} color="#8AD6FF" client:only="react" />
      </section>
    )}

    {califChartData.length === 0 && importeChartData.length === 0 && (
      <section class="data-section">
        <div class="empty-state">
          <p class="empty-state-main mono">No hay datos disponibles para generar gráficos.</p>
        </div>
      </section>
    )}

    <!-- Mapa -->
    {mapPoints.length > 0 && (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Localización de denuncias</span>
          <span class="mono ts">{mapPoints.length} de {rows.length} con coordenadas</span>
        </div>
        <div class="map-card">
          <div id="map-multas"></div>
          <div class="map-legend">
            <span class="legend-dot" style="background:#00DB7C"></span><span class="mono">Leve</span>
            <span class="legend-dot" style="background:#E2A66E; margin-left:1rem"></span><span class="mono">Grave</span>
            <span class="legend-dot" style="background:#ff6b6b; margin-left:1rem"></span><span class="mono">Muy Grave</span>
            <span class="legend-dot" style="background:#8AD6FF; margin-left:1rem"></span><span class="mono">Otros</span>
          </div>
        </div>
      </section>
    )}

    <div class="tier-notice">
      <p>Datos históricos 2015–2018. El Ayuntamiento de Gijón no publica multas posteriores en su portal de datos abiertos.</p>
    </div>
    </>
    )}
  </div>
</Layout>

<script type="application/json" id="multas-mapdata" set:html={JSON.stringify(mapPoints)}></script>

<script>
import maplibregl from 'maplibre-gl'
import 'maplibre-gl/dist/maplibre-gl.css'

// ── Mapa ──────────────────────────────────────────────────────────────────
let mapInstance: maplibregl.Map | null = null

function initMap() {
  const mapEl = document.getElementById('map-multas')
  const rawMap = document.getElementById('multas-mapdata')
  if (!mapEl || !rawMap) return

  if (mapInstance) { mapInstance.remove(); mapInstance = null }

  const points: Array<{ lat: number; lon: number; tipo: string; calif: string; importe: number; color: string }> =
    JSON.parse(rawMap.textContent!)

  mapInstance = new maplibregl.Map({
    container: mapEl,
    style: 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json',
    center: [-5.6618, 43.5452],
    zoom: 13,
    scrollZoom: false,
    attributionControl: { compact: true },
  })

  mapInstance.addControl(new maplibregl.NavigationControl(), 'top-right')

  const geojson: GeoJSON.FeatureCollection = {
    type: 'FeatureCollection',
    features: points.map(p => ({
      type: 'Feature',
      geometry: { type: 'Point', coordinates: [p.lon, p.lat] },
      properties: { ...p },
    })),
  }

  mapInstance.on('load', () => {
    mapInstance!.addSource('points', { type: 'geojson', data: geojson })

    mapInstance!.addLayer({
      id: 'points-glow',
      type: 'circle',
      source: 'points',
      paint: {
        'circle-radius': 9,
        'circle-color': ['get', 'color'],
        'circle-opacity': 0.12,
      },
    })

    mapInstance!.addLayer({
      id: 'points-core',
      type: 'circle',
      source: 'points',
      paint: {
        'circle-radius': 3.5,
        'circle-color': ['get', 'color'],
        'circle-opacity': 0.85,
        'circle-stroke-width': 1,
        'circle-stroke-color': ['get', 'color'],
      },
    })

    mapInstance!.on('click', 'points-core', (e) => {
      const p = e.features![0].properties!
      new maplibregl.Popup({ offset: 8, closeButton: false })
        .setLngLat(e.lngLat)
        .setHTML(`<div style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;background:#111;border:1px solid #333;color:#e8e8e8;padding:8px 12px;box-shadow:0 4px 20px rgba(0,0,0,.7)"><div style="font-weight:600;margin-bottom:4px">${p.tipo}</div><div style="opacity:0.8">${p.calif} · ${p.importe ? p.importe + '€' : 'N/D'}</div></div>`)
        .addTo(mapInstance!)
    })

    mapInstance!.on('mouseenter', 'points-core', () => {
      mapInstance!.getCanvas().style.cursor = 'pointer'
    })
    mapInstance!.on('mouseleave', 'points-core', () => {
      mapInstance!.getCanvas().style.cursor = ''
    })
  })
}

document.addEventListener('astro:page-load', () => requestAnimationFrame(initMap))
</script>

<style>
  .container { max-width: var(--container-max); margin: 0 auto; padding: 2rem var(--gutter); }

  .page-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);
  }
  .page-header h1 { margin: 0.75rem 0 0.4rem; }
  .page-header p  { font-size: 0.9375rem; color: var(--text-muted); margin: 0; }

  .tier-notice {
    padding: 0.75rem 1rem; border: 1px dashed var(--amber-dim);
    margin-bottom: 2.5rem; background: var(--amber-faint);
  }
  .tier-notice p { font-size: 0.8125rem; color: var(--text-dim); margin: 0; }

  .data-section { margin-bottom: 3rem; }
  .section-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;
  }
  .ts { font-size: 0.6875rem; color: var(--text-muted); }

  .metrics-row {
    display: grid; grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--border); overflow: hidden;
  }
  .metric-cell {
    padding: 1.25rem; border-right: 1px solid var(--border);
    background: var(--surface); display: flex; flex-direction: column; gap: 0.5rem;
  }
  .metric-cell:last-child { border-right: none; }
  .metric-label { font-size: 0.625rem; color: var(--text-muted); letter-spacing: 0.04em; }
  .metric-main  { display: flex; align-items: baseline; gap: 0.4rem; }
  .metric-val   { font-size: 2rem; font-weight: 500; line-height: 1; }
  .metric-unit  { font-size: 0.6875rem; color: var(--text-muted); }
  .metric-bar   { height: 2px; background: var(--border); overflow: hidden; }
  .metric-fill  { height: 100%; transition: width 0.4s; }
  .calidad-tag  { font-size: 0.625rem; color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.05em; }

  .chart-card {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.25rem;
  }

  /* Mapa */
  .map-card {
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }
  #map-multas {
    height: 420px;
    width: 100%;
  }
  .map-legend {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.625rem; color: var(--text-muted);
    border-top: 1px solid var(--border);
    background: var(--surface);
    letter-spacing: 0.05em;
    font-family: 'IBM Plex Mono', monospace;
  }
  .legend-dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  }

  .label { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .label-amber { color: var(--amber); }
  .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; border: 1px solid var(--border); color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; }
  .badge-free { color: var(--text-muted); }
  .badge-pro  { color: var(--lavender); border-color: color-mix(in srgb, var(--lavender) 45%, transparent); }

  /* MapLibre overrides */
  :global(.maplibregl-popup-content-wrapper) {
    border-radius: 0 !important;
    background: #111 !important;
    border: 1px solid #333 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,.7) !important;
  }
  :global(.maplibregl-popup-content) {
    padding: 0 !important;
    margin: 0 !important;
  }
  :global(.maplibregl-popup-tip) { display: none; }
  :global(.maplibregl-popup-close-button) { color: #888 !important; }
  :global(.maplibregl-ctrl-group button) {
    background: #111 !important; color: #ccc !important;
    border-color: #333 !important; border-radius: 0 !important;
  }
  :global(.maplibregl-ctrl-group button:hover) { background: #222 !important; color: #fff !important; }
  :global(.maplibregl-ctrl-attrib) {
    background: rgba(0,0,0,.6) !important; color: #555 !important; font-size: 0.55rem !important;
  }
  :global(.maplibregl-ctrl-attrib a) { color: #666 !important; }

  @media (max-width: 900px) {
    .metrics-row { grid-template-columns: repeat(3, 1fr); }
    .metric-cell:nth-child(3) { border-right: none; }
    .metric-cell:nth-child(1),
    .metric-cell:nth-child(2),
    .metric-cell:nth-child(3) { border-bottom: 1px solid var(--border); }
  }
  @media (max-width: 600px) {
    .page-header { flex-direction: column; gap: 1rem; }
    .metrics-row { grid-template-columns: repeat(2, 1fr); }
    .metric-cell:nth-child(2n) { border-right: none; }
    .metric-cell:not(:nth-last-child(-n+1)) { border-bottom: 1px solid var(--border); }
    #map-multas { height: 320px; }
  }
</style>
