---
import Layout from '../layouts/Layout.astro'
import { getSession, createSupabaseClient } from '../server/supabase'

let errorMsg = ''
let successMsg = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const email = form.get('email') as string
  const password = form.get('password') as string

  const supabase = createSupabaseClient(Astro.cookies, Astro.request)
  const { error } = await supabase.auth.signUp({
    email,
    password,
    options: {
      emailRedirectTo: `${Astro.url.origin}/auth/callback`
    }
  })

  if (error) {
    errorMsg = error.message
  } else {
    successMsg = 'Revisa tu email para confirmar la cuenta.'
  }
} else {
  const { user } = await getSession(Astro.cookies, Astro.request)
  if (user) return Astro.redirect('/app/dashboard')
}
---

<Layout title="Crear cuenta">
  <div class="auth-wrap">
    <div class="auth-box animate-up delay-1">
      <div class="auth-header-px">
        <svg class="auth-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M9 2h6v2H9zm0 8h6v2H9zm6-6h2v6h-2zM7 4h2v6H7zM4 18h2v4H4zm14 0h2v4h-2zM8 14h8v2H8zm-2 2h2v2H6z"/>
          <path d="M18 16h2v6h-2z"/>
          <path d="M16 18h6v2h-6z"/>
        </svg>
        <h1>Crear cuenta</h1>
      </div>
      <p class="auth-sub">Gratis. 30 días de histórico, 100 req/día. Sin tarjeta.</p>

      {successMsg ? (
        <p class="auth-msg auth-success">{successMsg}</p>
      ) : (
        <form method="post" class="auth-form">
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="tu@email.com" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Mínimo 8 caracteres" minlength="8" required autocomplete="new-password" />
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
            Crear cuenta
          </button>
        </form>
      )}

      {errorMsg && <p class="auth-msg auth-error">{errorMsg}</p>}

      <p class="auth-footer">¿Ya tienes cuenta? <a href="/login">Entrar</a></p>
    </div>
  </div>
</Layout>

<style>
  .auth-wrap {
    display: flex;
    justify-content: center;
    padding: 4rem 0;
  }

  .auth-box {
    width: 100%;
    max-width: 400px;
    padding: 2.5rem;
    background: var(--surface);
    border: 2px solid var(--border);
    box-shadow: 8px 8px 0px var(--border);
  }

  .auth-header-px {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .auth-icon { color: var(--accent); }

  .auth-box h1 {
    font-size: 1.75rem;
    margin: 0;
  }

  .auth-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  .auth-msg {
    font-size: 0.8125rem;
    margin-top: 0.75rem;
  }
  .auth-error { color: var(--brick); }
  .auth-success { color: var(--sage); }

  .auth-footer {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .auth-footer a { color: var(--amber); font-weight: 500; }

  .auth-form .btn {
    border-radius: 0;
    border: 2px solid var(--text);
    box-shadow: 4px 4px 0px var(--text);
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }
  .auth-form .btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--text);
  }
  .auth-form .btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0px 0px 0px var(--text);
  }

  .auth-form input {
    border: 2px solid var(--border);
    border-radius: 0;
    padding: 0.75rem 1rem;
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    transition: border-color 0.1s steps(2), box-shadow 0.1s steps(2);
  }
  .auth-form input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 4px 4px 0px color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>
