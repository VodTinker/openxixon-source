---
import Layout from '../layouts/Layout.astro'
import { db } from '../server/supabase'
import { buildSpark, SPARK_W, SPARK_H } from '../lib/spark'

const [aireQ, poblacionQ, inversionesQ, multasQ, incidenciasQ] = await Promise.all([
  db.from('calidad_aire')
    .select('fecha, no2', { count: 'exact', head: false })
    .not('no2', 'is', null)
    .order('fecha', { ascending: false })
    .limit(30),
  db.from('poblacion_barrios')
    .select('fecha, datos', { count: 'exact', head: false })
    .order('fecha', { ascending: false })
    .limit(500),
  db.from('inversiones')
    .select('fecha_adjudicacion, importe_adjudicacion', { count: 'exact', head: false })
    .not('fecha_adjudicacion', 'is', null)
    .not('importe_adjudicacion', 'is', null)
    .order('fecha_adjudicacion', { ascending: false })
    .limit(30),
  db.from('multas_trafico')
    .select('anio, importe', { count: 'exact', head: false })
    .order('anio', { ascending: false })
    .limit(200),
  db.from('incidencias_urbanas')
    .select('fecha, tipo, estado', { count: 'exact', head: false })
    .order('fecha', { ascending: false })
    .limit(200),
])

function ago(fecha: string | null | undefined): string {
  if (!fecha) return 'sin datos'
  const mins = Math.max(0, Math.round((Date.now() - new Date(fecha).getTime()) / 60000))
  if (mins < 60) return `hace ${mins} min`
  const h = Math.round(mins / 60)
  if (h < 24) return `hace ${h} h`
  const d = Math.round(h / 24)
  if (d < 30) return `hace ${d} d`
  const m = Math.round(d / 30)
  return `hace ${m} mes${m > 1 ? 'es' : ''}`
}

function fmtNum(n: number | null | undefined, decimals = 0): string {
  if (n == null) return '—'
  return n.toLocaleString('es-ES', { maximumFractionDigits: decimals })
}

// KPI + spark per dataset
const aireData    = (aireQ.data ?? []) as any[]
const poblData    = (poblacionQ.data ?? []) as any[]
const invData     = (inversionesQ.data ?? []) as any[]
const multasData  = (multasQ.data ?? []) as any[]
const incData     = (incidenciasQ.data ?? []) as any[]

const aireSpark   = buildSpark(aireData.map((r: any) => r.no2))

// Population: datos jsonb has nested `total` per barrio row; aggregate by fecha
const poblByFecha: Record<string, number> = {}
for (const r of poblData) {
  const d = r.datos as Record<string, unknown> | null
  const total = d?.total != null ? Number(d.total) : 0
  const f = (r.fecha as string | null)?.split('T')[0] ?? ''
  if (f) poblByFecha[f] = (poblByFecha[f] ?? 0) + total
}
const poblFechas = Object.keys(poblByFecha).sort().reverse()
const poblLatestTotal = poblFechas.length > 0 ? poblByFecha[poblFechas[0]] : null
const poblSpark = buildSpark(poblFechas.map(f => poblByFecha[f]))
const invSpark    = buildSpark(invData.map((r: any) => r.importe_adjudicacion))

// Multas: average importe across all rows
const multasImportes = multasData.map((r: any) => r.importe).filter((v: any) => v != null)
const multasAvg = multasImportes.length
  ? multasImportes.reduce((a: number, b: number) => a + b, 0) / multasImportes.length
  : null
// Multas spark: group by year, sum
const multasByYear: Record<string, number> = {}
for (const r of multasData) {
  const y = String(r.anio ?? '')
  if (y) multasByYear[y] = (multasByYear[y] ?? 0) + (r.importe ?? 0)
}
const multasSpark = buildSpark(Object.keys(multasByYear).sort().reverse().map(k => multasByYear[k]))

// Incidencias spark: group by date
const incByDate: Record<string, number> = {}
for (const r of incData) {
  const d = (r.fecha as string | null)?.split('T')[0]
  if (d) incByDate[d] = (incByDate[d] ?? 0) + 1
}
const incSpark = buildSpark(Object.keys(incByDate).sort().reverse().map(k => incByDate[k]))
const incAbiertas = incData.filter((r: any) =>
  typeof r.estado === 'string' && r.estado.toLowerCase().includes('abiert')
).length

const datasets = [
  {
    href: '/aire',
    title: 'Calidad del aire',
    desc: 'NO₂, PM10, O₃, PM2.5 — estaciones municipales.',
    freq: 'Diaria',
    color: 'var(--color-mint, #34d399)',
    spark: aireSpark,
    kpiValue: aireData[0]?.no2 != null ? `${fmtNum(aireData[0].no2, 1)} µg/m³` : '—',
    kpiLabel: 'NO₂ actual',
    count: aireQ.count ?? 0,
    lastUpdate: ago(aireData[0]?.fecha),
  },
  {
    href: '/poblacion',
    title: 'Población',
    desc: 'Padrón municipal por barrios y pirámide demográfica.',
    freq: 'Anual',
    color: 'var(--color-sky, #38bdf8)',
    spark: poblSpark,
    kpiValue: poblLatestTotal != null ? `${fmtNum(poblLatestTotal)} hab.` : '—',
    kpiLabel: 'último padrón',
    count: poblacionQ.count ?? 0,
    lastUpdate: ago(poblData[0]?.fecha),
  },
  {
    href: '/inversiones',
    title: 'Inversiones',
    desc: 'Contratos públicos: presupuestado vs adjudicado.',
    freq: 'Mensual',
    color: 'var(--color-lavender, #a78bfa)',
    spark: invSpark,
    kpiValue: (() => {
      const v = invData[0]?.importe_adjudicacion
      if (v == null) return '—'
      if (v >= 1_000_000) return `${fmtNum(v / 1_000_000, 2)} M€`
      if (v >= 1_000) return `${fmtNum(v / 1_000, 1)} k€`
      return `${fmtNum(v, 0)} €`
    })(),
    kpiLabel: 'último contrato',
    count: inversionesQ.count ?? 0,
    lastUpdate: ago(invData[0]?.fecha_adjudicacion),
  },
  {
    href: '/multas',
    title: 'Multas de tráfico',
    desc: 'Sanciones por calificación e importe.',
    freq: 'Anual',
    color: 'var(--color-peach, #fb923c)',
    spark: multasSpark,
    kpiValue: multasAvg != null ? `${fmtNum(multasAvg, 0)} €` : '—',
    kpiLabel: 'importe medio',
    count: multasQ.count ?? 0,
    lastUpdate: 'datos anuales',
  },
  {
    href: '/incidencias',
    title: 'Incidencias urbanas',
    desc: 'Reportes ciudadanos: tipos, estados, evolución.',
    freq: 'Diaria',
    color: 'var(--accent)',
    spark: incSpark,
    kpiValue: incAbiertas > 0 ? `${fmtNum(incAbiertas)} abiertas` : `${fmtNum(incData.length)} recientes`,
    kpiLabel: 'estado actual',
    count: incidenciasQ.count ?? 0,
    lastUpdate: ago(incData[0]?.fecha),
  },
]

function deltaBadge(delta: number | null): { sign: string; cls: string; value: string } | null {
  if (delta == null || delta === 0) return null
  const sign = delta > 0 ? '↑' : '↓'
  const cls  = delta > 0 ? 'up' : 'down'
  const abs  = Math.abs(delta)
  const value = abs >= 1_000_000
    ? `${(abs / 1_000_000).toFixed(1)}M`
    : abs >= 1_000
      ? `${(abs / 1_000).toFixed(1)}k`
      : abs < 1
        ? abs.toFixed(2)
        : fmtNum(abs, 0)
  return { sign, cls, value }
}

const totalRecords = datasets.reduce((s, d) => s + d.count, 0)
---

<Layout title="Datos abiertos · OpenXixón">
  <div class="container">
    <header class="datos-header">
      <span class="label mono">Catálogo</span>
      <h1>Datos abiertos de Gijón</h1>
      <p class="datos-meta mono">
        {datasets.length} datasets · {totalRecords.toLocaleString('es-ES')} registros · ingesta diaria
      </p>
    </header>

    <div class="datos-grid">
      {datasets.map(d => {
        const badge = deltaBadge(d.spark.delta)
        const lastPt = d.spark.points[d.spark.points.length - 1]
        return (
          <a href={d.href} class="datos-card" style={`--card-accent: ${d.color}`}>
            <div class="dc-top-bar"></div>
            <div class="dc-body">
              <div class="dc-h">
                <h2 class="dc-title">{d.title}</h2>
                <span class="dc-freq mono">{d.freq}</span>
              </div>
              <p class="dc-desc">{d.desc}</p>

              <div class="dc-kpi">
                <span class="dc-kpi-value">{d.kpiValue}</span>
                <div class="dc-kpi-right">
                  {badge && (
                    <span class:list={['dc-delta', 'mono', badge.cls]}>
                      {badge.sign}{badge.value}
                    </span>
                  )}
                  <span class="dc-kpi-label mono">{d.kpiLabel}</span>
                </div>
              </div>

              {d.spark.line ? (
                <svg class="dc-spark" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id={`sg-${d.href.slice(1)}`} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--card-accent)" stop-opacity="0.35"/>
                      <stop offset="100%" stop-color="var(--card-accent)" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <polygon
                    points={d.spark.area}
                    fill={`url(#sg-${d.href.slice(1)})`}
                  />
                  <polyline
                    points={d.spark.line}
                    fill="none"
                    stroke="var(--card-accent)"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"
                  />
                  {lastPt && (
                    <circle
                      cx={lastPt.x.toFixed(1)}
                      cy={lastPt.y.toFixed(1)}
                      r="3"
                      fill="var(--card-accent)"
                      vector-effect="non-scaling-stroke"
                    />
                  )}
                </svg>
              ) : <div class="dc-spark dc-spark--empty mono">sin datos</div>}

              <div class="dc-foot">
                <span class="mono">{d.count.toLocaleString('es-ES')} registros</span>
                <span class="mono">{d.lastUpdate}</span>
              </div>
            </div>
          </a>
        )
      })}
    </div>
  </div>
</Layout>

<style>
  .container { max-width: var(--container-max, 1200px); margin: 0 auto; padding: 3rem var(--gutter, 1.5rem); }

  .datos-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .datos-header h1 { margin: 0.5rem 0 0.4rem; font-size: 2rem; font-weight: 400; letter-spacing: -0.02em; }
  .datos-meta { font-size: 0.8125rem; color: var(--text-muted); letter-spacing: 0.04em; }

  .datos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  /* ── Card ── */
  .datos-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s, transform 0.15s, border-color 0.15s;
    border: 1px solid transparent;
    margin: -1px;
  }
  .datos-card:hover {
    background: var(--surface-2, var(--surface));
    transform: translateY(-2px);
    border-color: var(--card-accent);
    z-index: 1;
  }

  /* Colored top border */
  .dc-top-bar {
    height: 3px;
    background: var(--card-accent);
    flex-shrink: 0;
  }

  .dc-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    flex: 1;
  }

  .dc-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
  .dc-title { font-size: 1.0625rem; font-weight: 500; margin: 0; letter-spacing: -0.01em; }
  .dc-freq {
    font-size: 0.5625rem; padding: 0.15rem 0.4rem;
    border: 1px solid var(--border);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .dc-desc { font-size: 0.8125rem; color: var(--text-muted); margin: 0; line-height: 1.5; }

  /* ── KPI row ── */
  .dc-kpi {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .dc-kpi-value {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
  }
  .dc-kpi-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }
  .dc-kpi-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* ── Delta badge ── */
  .dc-delta {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm, 4px);
    letter-spacing: 0.02em;
  }
  .dc-delta.up   { color: #10b981; background: color-mix(in srgb, #10b981 12%, transparent); }
  .dc-delta.down { color: #f87171; background: color-mix(in srgb, #f87171 12%, transparent); }

  /* ── Sparkline ── */
  .dc-spark { width: 100%; height: 56px; display: block; }
  .dc-spark--empty {
    height: 56px;
    display: flex; align-items: center;
    font-size: 0.625rem; color: var(--text-muted);
    border: 1px dashed var(--border);
    padding: 0 0.5rem;
  }

  /* ── Footer ── */
  .dc-foot {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: auto;
    padding-top: 0.75rem; border-top: 1px solid var(--border);
    font-size: 0.6875rem; color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .datos-grid { grid-template-columns: 1fr; }
  }
</style>
