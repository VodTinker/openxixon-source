---
import Layout from '../layouts/Layout.astro'

const GRID_COLS = 24
const GRID_ROWS = 16
const CELL = 12

const pixelBlocks = Array.from({ length: 120 }, (_, i) => {
  const x = (i * 7 + (i % 5) * 3) % GRID_COLS
  const y = (i * 11 + (i % 4) * 5) % GRID_ROWS
  const toneIndex = (i * 13 + y * 3) % 4
  const tone = toneIndex === 0 ? 'mint' : toneIndex === 1 ? 'sky' : toneIndex === 2 ? 'lavender' : 'dim'
  return { x, y, tone }
})

const sparkline = [8, 15, 12, 20, 14, 22, 17, 25, 18, 14, 19, 13]
const sparkPoints = sparkline
  .map((value, index) => `${index * 22},${32 - value}`)
  .join(' ')
---

<Layout title="404" description="Página no encontrada">
  <section class="not-found container">
    <div class="nf-grid">
      <div class="nf-copy animate-up delay-1">
        <div class="nf-kicker">
          <span class="status-dot"></span>
          <span class="label">Error de ruta</span>
        </div>

        <p class="nf-code mono">404 // PAGE_NOT_FOUND</p>
        <h1 class="nf-title">Te perdiste entre píxeles.</h1>
        <p class="nf-sub">
          La URL no existe o ya no está disponible. Vuelve al portal y sigue explorando los datos abiertos de Gijón.
        </p>

        <div class="nf-cta">
          <a href="/" class="btn btn-primary">Volver al inicio</a>
          <a href="/docs" class="btn btn-secondary">Ir a la API</a>
        </div>

        <div class="nf-mini card">
          <div class="nf-mini-head">
            <span class="badge badge-accent">Estado</span>
            <span class="mono">RUTA INVALIDA</span>
          </div>
          <div class="nf-mini-body">
            <span class="mono">/api/...</span>
            <svg viewBox="0 0 250 32" preserveAspectRatio="none" aria-hidden="true">
              <polyline points={sparkPoints} />
            </svg>
          </div>
        </div>
      </div>

      <div class="nf-art animate-up delay-3" aria-hidden="true">
        <div class="pixel-frame">
          <div class="scanline"></div>
          <svg viewBox={`0 0 ${GRID_COLS * CELL} ${GRID_ROWS * CELL}`} class="pixel-map">
            {pixelBlocks.map((block) => (
              <rect
                class:list={[
                  'pixel',
                  `pixel--${block.tone}`
                ]}
                x={block.x * CELL + 1}
                y={block.y * CELL + 1}
                width={CELL - 2}
                height={CELL - 2}
              />
            ))}

            <rect class="target" x={11 * CELL} y={7 * CELL} width={CELL * 2} height={CELL * 2} />
            <line class="target-line" x1={12 * CELL} y1={0} x2={12 * CELL} y2={GRID_ROWS * CELL} />
            <line class="target-line" x1={0} y1={8 * CELL} x2={GRID_COLS * CELL} y2={8 * CELL} />
          </svg>

          <div class="pixel-caption">
            <span class="mono">NO SIGNAL</span>
            <span class="label">Navegación fuera de mapa</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding-block: clamp(2rem, 7vw, 5rem);
  }

  .nf-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--border);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 85%, transparent) 0%, transparent 100%),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--border) 28%, transparent) 0,
        color-mix(in srgb, var(--border) 28%, transparent) 1px,
        transparent 1px,
        transparent 18px
      );
    box-shadow: var(--shadow-md);
  }

  .nf-copy,
  .nf-art {
    padding: clamp(1.2rem, 2.6vw, 2.4rem);
  }

  .nf-copy {
    border-right: 1px solid var(--border);
  }

  .nf-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .nf-code {
    color: var(--lavender);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .nf-title {
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 0.95;
    margin-bottom: 0.9rem;
  }

  .nf-sub {
    max-width: 44ch;
    margin-bottom: 1.2rem;
  }

  .nf-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .nf-mini {
    max-width: 440px;
    background: color-mix(in srgb, var(--surface-2) 55%, transparent);
  }

  .nf-mini-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .nf-mini-head .mono {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .nf-mini-body {
    border: 1px solid var(--border);
    padding: 0.75rem;
    display: grid;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .nf-mini-body .mono {
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  .nf-mini-body svg {
    width: 100%;
    height: 42px;
    overflow: visible;
  }

  .nf-mini-body polyline {
    fill: none;
    stroke: var(--mint);
    stroke-width: 2;
  }

  .pixel-frame {
    position: relative;
    border: 1px solid var(--border-mid);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    padding: 0.9rem;
    overflow: hidden;
  }

  .pixel-map {
    width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 80%, transparent), color-mix(in srgb, var(--bg) 90%, transparent));
  }

  .pixel {
    shape-rendering: crispEdges;
    animation: flicker 3.8s steps(2, end) infinite;
  }

  .pixel--mint { fill: color-mix(in srgb, var(--mint) 70%, var(--surface)); }
  .pixel--sky { fill: color-mix(in srgb, var(--sky) 68%, var(--surface)); }
  .pixel--lavender { fill: color-mix(in srgb, var(--lavender) 65%, var(--surface)); }
  .pixel--dim { fill: color-mix(in srgb, var(--surface-3) 80%, var(--bg)); }

  .target {
    fill: transparent;
    stroke: var(--red);
    stroke-width: 2;
    shape-rendering: crispEdges;
  }

  .target-line {
    stroke: color-mix(in srgb, var(--red) 42%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    shape-rendering: crispEdges;
  }

  .scanline {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 4px
    );
    mix-blend-mode: screen;
  }

  .pixel-caption {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .pixel-caption .mono {
    color: var(--red);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  @keyframes flicker {
    0%, 100% { opacity: 1; }
    12% { opacity: 0.82; }
    16% { opacity: 1; }
    62% { opacity: 0.9; }
    66% { opacity: 1; }
  }

  @media (max-width: 980px) {
    .nf-grid {
      grid-template-columns: 1fr;
    }

    .nf-copy {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
