<script>
  // ── Scrollspy: sidebar resalta la sección visible ──
  // Re-inicializa en cada navegación SPA (astro:page-load) y desconecta antes
  // del swap para evitar fugas de memoria al cambiar de página.
  let docsObserver: IntersectionObserver | null = null

  function initDocsScrollspy() {
    const sections = document.querySelectorAll('.docs-main section[id]')
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.sidebar-nav a')
    if (!sections.length || !navLinks.length) return

    docsObserver?.disconnect()
    docsObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        const id = `#${entry.target.id}`
        navLinks.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === id)
        })
      }
    }, { rootMargin: '-100px 0px -60% 0px' })

    sections.forEach(s => docsObserver!.observe(s))
  }

  function teardownDocsScrollspy() {
    docsObserver?.disconnect()
    docsObserver = null
  }

  // ── Copy buttons: handler único delegado ──
  // Reemplaza los 7 onclick inline. Da feedback visual breve al copiar.
  function handleCopyClick(e: Event) {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-copy')
    if (!btn) return
    const pre = btn.closest('.code-header')?.nextElementSibling as HTMLElement | null
      ?? btn.parentElement?.nextElementSibling as HTMLElement | null
    if (!pre) return
    const text = pre.textContent ?? ''
    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add('is-copied')
      setTimeout(() => btn.classList.remove('is-copied'), 1200)
    }).catch(() => { /* clipboard bloqueado: silenciar */ })
  }

  initDocsScrollspy()
  document.addEventListener('astro:page-load', initDocsScrollspy)
  document.addEventListener('astro:before-swap', teardownDocsScrollspy)
  document.addEventListener('click', handleCopyClick)
</script>

