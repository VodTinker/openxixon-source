---
import AppLayout from '../../layouts/AppLayout.astro'
import { db, getSession } from '../../server/supabase'

const { user } = await getSession(Astro.cookies, Astro.request)

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('action')

  if (action === 'create') {
    await db.from('alertas').insert({
      user_id: user!.id,
      parametro: form.get('parametro'),
      operador: form.get('operador'),
      umbral: Number(form.get('umbral')),
    })
  } else if (action === 'delete') {
    await db.from('alertas').delete().eq('id', form.get('id')).eq('user_id', user!.id)
  } else if (action === 'toggle') {
    const { data: alerta } = await db.from('alertas').select('activa').eq('id', form.get('id')).single()
    await db.from('alertas').update({ activa: !alerta?.activa }).eq('id', form.get('id')).eq('user_id', user!.id)
  }

  return Astro.redirect('/app/alertas')
}

const { data: alertas } = await db
  .from('alertas')
  .select('*')
  .eq('user_id', user!.id)
  .order('created_at', { ascending: false })

const parametros = [
  { key: 'no2',  label: 'NO₂',   tone: 'mint',     desc: 'Dióxido de nitrógeno' },
  { key: 'o3',   label: 'O₃',    tone: 'lavender', desc: 'Ozono troposférico' },
  { key: 'pm10', label: 'PM10',  tone: 'accent',   desc: 'Partículas ≤10 µm' },
  { key: 'pm25', label: 'PM2.5', tone: 'peach',    desc: 'Partículas ≤2.5 µm' },
  { key: 'co',   label: 'CO',    tone: 'sky',      desc: 'Monóxido de carbono' },
]
const toneFor = (p: string) => parametros.find(x => x.key === p)?.tone ?? 'accent'
const labelFor = (p: string) => parametros.find(x => x.key === p)?.label ?? p.toUpperCase()

const total = alertas?.length ?? 0
const activas = alertas?.filter((a: any) => a.activa).length ?? 0
---

<AppLayout title="Alertas">
  <div class="al-accent-line" aria-hidden="true"></div>

  <header class="al-top">
    <div>
      <span class="label">Monitoreo · Umbrales</span>
      <h1>Alertas</h1>
      <p class="al-sub">Recibe un email cuando un parámetro supere o baje de un umbral.</p>
    </div>
    <div class="al-counter">
      <div class="al-counter-cell">
        <span class="al-cc-value mono">{activas}</span>
        <span class="al-cc-label mono">ACTIVAS</span>
      </div>
      <div class="al-counter-cell">
        <span class="al-cc-value mono">{total}</span>
        <span class="al-cc-label mono">TOTAL</span>
      </div>
    </div>
  </header>

  <!-- ─── Nueva alerta (builder) ─── -->
  <section class="panel">
    <div class="panel-head">
      <span class="label">Crear nueva alerta</span>
    </div>
    <form method="POST" class="alert-builder">
      <input type="hidden" name="action" value="create" />

      <div class="ab-field">
        <span class="ab-label mono">1 · PARÁMETRO</span>
        <div class="ab-params">
          {parametros.map((p, i) => (
            <label class:list={['ab-param', `ab-param--${p.tone}`]}>
              <input type="radio" name="parametro" value={p.key} required checked={i === 0} />
              <span class="ab-param-label">{p.label}</span>
              <span class="ab-param-desc">{p.desc}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="ab-row">
        <div class="ab-field ab-field--op">
          <span class="ab-label mono">2 · OPERADOR</span>
          <div class="ab-ops">
            <label class="ab-op">
              <input type="radio" name="operador" value="gt" required checked />
              <span>&gt;</span>
              <span class="ab-op-desc">mayor que</span>
            </label>
            <label class="ab-op">
              <input type="radio" name="operador" value="lt" required />
              <span>&lt;</span>
              <span class="ab-op-desc">menor que</span>
            </label>
          </div>
        </div>

        <div class="ab-field ab-field--umbral">
          <span class="ab-label mono">3 · UMBRAL (µg/m³)</span>
          <input type="number" name="umbral" placeholder="p. ej. 40" required min="0" step="0.1" class="ab-umbral-input mono" />
        </div>

        <div class="ab-submit">
          <button type="submit" class="btn btn-primary">Crear alerta</button>
        </div>
      </div>
    </form>
  </section>

  <!-- ─── Lista de alertas ─── -->
  <section class="panel">
    <div class="panel-head">
      <span class="label">Alertas configuradas</span>
      <span class="panel-meta mono">{total} en total</span>
    </div>

    {alertas && alertas.length > 0 ? (
      <div class="alerts-list">
        {alertas.map((a: any) => (
          <div class:list={['al-row', !a.activa && 'al-row--paused']}>
            <div class:list={['al-tag', `al-tag--${toneFor(a.parametro)}`]}>{labelFor(a.parametro)}</div>
            <div class="al-rule">
              <span class="al-rule-op mono">{a.operador === 'gt' ? '>' : '<'}</span>
              <span class="al-rule-val mono">{a.umbral}</span>
              <span class="al-rule-unit">µg/m³</span>
            </div>

            <div class="al-status-group">
              <span class:list={['al-status', a.activa ? 'al-status--on' : 'al-status--off']}>
                <span class="al-status-dot"></span>
                <span class="mono">{a.activa ? 'activa' : 'pausada'}</span>
              </span>
              {a.ultimo_envio && (
                <span class="al-last mono">último · {new Date(a.ultimo_envio).toLocaleDateString('es-ES')}</span>
              )}
            </div>

            <div class="al-actions">
              <form method="POST">
                <input type="hidden" name="action" value="toggle" />
                <input type="hidden" name="id" value={a.id} />
                <button type="submit" class="btn btn-ghost btn-sm">
                  {a.activa ? 'Pausar' : 'Activar'}
                </button>
              </form>
              <form method="POST">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={a.id} />
                <button type="submit" class="btn btn-ghost btn-sm al-delete">Eliminar</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-dot"></span>
        <p>No tienes alertas configuradas aún. Crea una arriba para recibir avisos por email.</p>
      </div>
    )}
  </section>
</AppLayout>

<style>
  .al-accent-line {
    height: 2px;
    width: calc(100% + 4rem);
    background: var(--accent-gradient);
    opacity: 0.9;
    margin: -2rem -2rem 2rem;
  }

  .al-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .al-top h1 {
    font-size: 1.75rem;
    font-weight: 400;
    margin: 0.5rem 0 0.2rem;
    letter-spacing: -0.02em;
  }
  .al-sub { font-size: 0.8125rem; color: var(--text-dim); }

  .al-counter {
    display: flex;
    border: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0;
  }
  .al-counter-cell {
    padding: 0.6rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    border-right: 1px solid var(--border);
    min-width: 70px;
  }
  .al-counter-cell:last-child { border-right: none; }
  .al-cc-value {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1;
  }
  .al-cc-label {
    font-size: 0.5625rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .panel { margin-bottom: 2.25rem; }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    gap: 1rem;
  }
  .panel-meta { font-size: 0.6875rem; color: var(--text-muted); }

  /* ─── Builder ─── */
  .alert-builder {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ab-field { display: flex; flex-direction: column; gap: 0.55rem; }
  .ab-label {
    font-size: 0.5625rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .ab-params {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .ab-param {
    position: relative;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg-1);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .ab-param:hover { border-color: var(--border-strong); }
  .ab-param input { position: absolute; opacity: 0; pointer-events: none; }
  .ab-param-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .ab-param-desc {
    font-size: 0.6875rem;
    color: var(--text-muted);
    line-height: 1.3;
  }
  /* Selected state: colored top bar + accent border */
  .ab-param:has(input:checked) {
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 7%, var(--bg-1));
  }
  .ab-param:has(input:checked)::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 2px;
    background: currentColor;
  }
  .ab-param--mint     { color: var(--mint); }
  .ab-param--lavender { color: var(--lavender); }
  .ab-param--accent   { color: var(--accent); }
  .ab-param--peach    { color: var(--peach); }
  .ab-param--sky      { color: var(--sky); }
  .ab-param-label, .ab-param-desc { color: var(--text); }
  .ab-param-desc { color: var(--text-muted); }

  .ab-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: end;
  }

  .ab-ops {
    display: flex;
    gap: 0.35rem;
  }
  .ab-op {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg-1);
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    transition: border-color 0.15s, background 0.15s;
  }
  .ab-op input { position: absolute; opacity: 0; pointer-events: none; }
  .ab-op span:first-of-type {
    font-size: 1rem;
    color: var(--text);
    font-weight: 500;
  }
  .ab-op-desc {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
  .ab-op:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .ab-umbral-input {
    width: 100%;
    background: var(--bg-1);
    border: 1px solid var(--border);
    padding: 0.55rem 0.75rem;
    color: var(--text);
    font-size: 0.9375rem;
    height: 44px;
  }
  .ab-umbral-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .ab-submit .btn { height: 44px; }

  /* ─── Lista ─── */
  .alerts-list {
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .al-row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 1.25rem;
    padding: 1rem 1.25rem;
    align-items: center;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .al-row:last-child { border-bottom: none; }
  .al-row:hover { background: var(--surface-2); }
  .al-row--paused { opacity: 0.6; }

  .al-tag {
    padding: 0.35rem 0.6rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid currentColor;
    letter-spacing: 0.04em;
  }
  .al-tag--mint     { color: var(--mint);     background: color-mix(in srgb, var(--mint) 10%, transparent); }
  .al-tag--lavender { color: var(--lavender); background: color-mix(in srgb, var(--lavender) 10%, transparent); }
  .al-tag--accent   { color: var(--accent);   background: var(--accent-soft); }
  .al-tag--peach    { color: var(--peach);    background: color-mix(in srgb, var(--peach) 10%, transparent); }
  .al-tag--sky      { color: var(--sky);      background: color-mix(in srgb, var(--sky) 10%, transparent); }

  .al-rule {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .al-rule-op {
    font-size: 1rem;
    color: var(--text-dim);
    font-weight: 500;
  }
  .al-rule-val {
    font-size: 1.125rem;
    color: var(--text);
    font-weight: 500;
  }
  .al-rule-unit {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .al-status-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }
  .al-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border: 1px solid currentColor;
  }
  .al-status-dot {
    width: 5px; height: 5px;
    background: currentColor;
    border-radius: 50%;
  }
  .al-status--on {
    color: var(--mint);
    background: color-mix(in srgb, var(--mint) 10%, transparent);
  }
  .al-status--on .al-status-dot {
    animation: alStatusPulse 1.8s ease-in-out infinite;
  }
  .al-status--off {
    color: var(--text-muted);
    background: var(--surface-2);
  }
  @keyframes alStatusPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.55; }
  }

  .al-last {
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .al-actions {
    display: flex;
    gap: 0.35rem;
  }
  .al-delete { color: var(--red); }
  .al-delete:hover { background: var(--red-soft); color: var(--red); }

  /* Empty */
  .empty-state {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 1.25rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .empty-dot {
    display: block;
    width: 6px; height: 6px;
    background: var(--text-muted);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .empty-state p { font-size: 0.8125rem; color: var(--text-muted); margin: 0; }

  @media (max-width: 900px) {
    .ab-params { grid-template-columns: repeat(2, 1fr); }
    .ab-row    { grid-template-columns: 1fr; }
  }

  @media (max-width: 700px) {
    .al-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .al-status-group { align-items: flex-start; }
  }

  @media (max-width: 600px) {
    .al-top { flex-direction: column; align-items: flex-start; }
  }
</style>
