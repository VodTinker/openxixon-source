---
import Layout from '../layouts/Layout.astro'
import { BarriosChart, PiramideChart } from '../components/charts/PoblacionChart'
import { db, getSession } from '../server/supabase'
import { getDateFilter } from '../lib/tier'
import type { Plan } from '../lib/tier'

const { user } = await getSession(Astro.cookies, Astro.request)
let plan: Plan = 'free'
if (user) {
  const { data: profile } = await db.from('profiles').select('plan').eq('user_id', user.id).single()
  plan = (profile?.plan as Plan) ?? 'free'
}

const dateFilter = getDateFilter(plan)

let errorMessage: string | null = null
let barrios: any[] = []
let general: any[] = []
let usandoFallbackHistorico = false

try {
  const { data: barriosFiltrado } = await db.from('poblacion_barrios').select('*').gte('fecha', dateFilter)
  const { data: generalFiltrado } = await db.from('poblacion').select('*').gte('fecha', dateFilter).limit(500)

  barrios = barriosFiltrado ?? []
  general = generalFiltrado ?? []

  if (barrios.length === 0) {
    const { data: fb } = await db.from('poblacion_barrios').select('*')
    if (fb && fb.length > 0) { barrios = fb; usandoFallbackHistorico = true }
  }
  if (general.length === 0) {
    const { data: fb } = await db.from('poblacion').select('*').limit(500)
    if (fb && fb.length > 0) { general = fb; usandoFallbackHistorico = true }
  }
} catch (e) {
  console.error('[SSR /poblacion]', e)
  errorMessage = 'No se pudieron cargar los datos de población. Inténtalo más tarde.'
}

const isFree = plan === 'free'

function toNumber(value: unknown): number | null {
  if (typeof value === 'number' && Number.isFinite(value)) return value
  if (typeof value === 'string') {
    const parsed = Number(value.replace(',', '.').trim())
    return Number.isFinite(parsed) ? parsed : null
  }
  return null
}

// Agregar barrios
const barrioMap = new Map<string, number>()
for (const r of barrios) {
  const d = r.datos as Record<string, unknown>
  const nombre = (d.barrio ?? d.nombre ?? '') as string
  if (!nombre) continue
  const pob = toNumber(d.total) ?? 0
  barrioMap.set(nombre, (barrioMap.get(nombre) ?? 0) + pob)
}
const barriosAgregados = Array.from(barrioMap.entries())
  .map(([nombre, total]) => ({ nombre, total }))
  .sort((a, b) => b.total - a.total)

const totalGijon = barriosAgregados.reduce((s, b) => s + b.total, 0)
const numBarrios = barriosAgregados.length

let totalMujeres = 0
let totalVarones = 0
for (const r of barrios) {
  const d = r.datos as Record<string, unknown>
  const sexo = ((d.sexo ?? '') as string).toLowerCase()
  const pob = toNumber(d.total) ?? 0
  if (sexo.includes('muj')) totalMujeres += pob
  else if (sexo.includes('var') || sexo.includes('hom')) totalVarones += pob
}

// Pirámide
const GRUPOS_ORDEN = [
  'De 0 a 4 años','De 5 a 9 años','De 10 a 14 años','De 15 a 19 años',
  'De 20 a 24 años','De 25 a 29 años','De 30 a 34 años','De 35 a 39 años',
  'De 40 a 44 años','De 45 a 49 años','De 50 a 54 años','De 55 a 59 años',
  'De 60 a 64 años','De 65 a 69 años','De 70 a 74 años','De 75 a 79 años',
  'De 80 a 84 años','De 85 a 89 años','De 90 a 94 años','De 95 a 99 años',
]

const pyramidMap = new Map<string, { muj: number; var: number }>()
for (const r of general) {
  const d = r.datos as Record<string, unknown>
  const grupo = (d.grupo_edad ?? '') as string
  const sexo  = ((d.sexo ?? '') as string).toLowerCase()
  const val   = toNumber(d.total) ?? 0
  if (!pyramidMap.has(grupo)) pyramidMap.set(grupo, { muj: 0, var: 0 })
  const entry = pyramidMap.get(grupo)!
  if (sexo.includes('muj')) entry.muj += val
  else if (sexo.includes('var')) entry.var += val
}

const pyramidData = GRUPOS_ORDEN
  .filter(g => pyramidMap.has(g))
  .map(g => ({
    grupo: g.replace('De ', '').replace(' años', ''),
    ...pyramidMap.get(g)!
  }))

// Data serializada para el cliente
const TOP_BARRIOS = barriosAgregados.slice(0, 20)

const chartBarrios = {
  labels: TOP_BARRIOS.map(b => b.nombre),
  values: TOP_BARRIOS.map(b => b.total),
}

const chartPyramid = {
  labels: pyramidData.map(p => p.grupo),
  varones: pyramidData.map(p => -p.var),
  mujeres: pyramidData.map(p => p.muj),
}
---

<Layout title="Población">
  <div class="container">
    <header class="page-header">
      <div>
        <span class="label label-amber">Datos demográficos</span>
        <h1>Población</h1>
        <p>Padrón municipal de Gijón. Distribución por barrios y grupos de edad.</p>
      </div>
      <span class:list={['badge', isFree ? 'badge-free' : 'badge-pro']}>{plan.toUpperCase()}</span>
    </header>

    {isFree && (
      <div class="tier-notice">
        <p>Histórico limitado a 30 días. Próximamente: acceso completo con planes Pro.</p>
      </div>
    )}

    {errorMessage && (
      <div class="tier-notice" style="border-color:var(--brick); background:color-mix(in srgb, var(--brick) 10%, transparent)">
        <p>{errorMessage}</p>
      </div>
    )}

    {usandoFallbackHistorico && !errorMessage && (
      <div class="tier-notice">
        <p>No hay registros dentro de la ventana de tu plan. Mostrando los últimos datos disponibles.</p>
      </div>
    )}

    {!errorMessage && (
    <>
    <!-- Stats -->
    <section class="data-section">
      <div class="stats-row">
        <div class="stat-cell">
          <span class="stat-label mono">POBLACIÓN TOTAL</span>
          <span class="stat-value mono">{totalGijon > 0 ? totalGijon.toLocaleString('es-ES') : '—'}</span>
          <span class="stat-sub">habitantes</span>
        </div>
        <div class="stat-cell">
          <span class="stat-label mono">BARRIOS</span>
          <span class="stat-value mono">{numBarrios || '—'}</span>
          <span class="stat-sub">núcleos</span>
        </div>
        <div class="stat-cell">
          <span class="stat-label mono">MUJERES / VARONES</span>
          <span class="stat-value mono" style="font-size:1.25rem">
            {totalGijon > 0
              ? ((totalMujeres / totalGijon) * 100).toFixed(1) + '% / ' + ((totalVarones / totalGijon) * 100).toFixed(1) + '%'
              : '—'}
          </span>
          <span class="stat-sub">del padrón</span>
        </div>
      </div>
    </section>

    <!-- Gráfico: barrios top 20 -->
    {TOP_BARRIOS.length > 0 && (
      <section class="data-section">
        <span class="label">Población por barrio — top 20</span>
        <BarriosChart barrios={barriosAgregados} total={totalGijon} client:only="react" />
      </section>
    )}

    <!-- Pirámide -->
    {pyramidData.length > 0 && (
      <section class="data-section">
        <div class="section-head">
          <span class="label">Pirámide de edad</span>
        </div>
        <PiramideChart pyramid={pyramidData} client:only="react" />
      </section>
    )}

    <!-- Tabla barrios completa -->
    <section class="data-section">
      <span class="label">Distribución completa por barrios</span>
      {barriosAgregados.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Barrio</th>
                <th>Habitantes</th>
                <th>% sobre total</th>
                <th style="min-width:100px">Peso</th>
              </tr>
            </thead>
            <tbody>
              {barriosAgregados.map(({ nombre, total }, idx) => {
                const pct = totalGijon > 0 ? (total / totalGijon) * 100 : 0
                return (
                  <tr>
                    <td class="mono" style="color:var(--text-muted); font-size:0.75rem">{idx + 1}</td>
                    <td style="font-weight:500; color:var(--text)">{nombre}</td>
                    <td class="mono" style="font-weight:600">{total.toLocaleString('es-ES')}</td>
                    <td class="mono">{pct.toFixed(2)}%</td>
                    <td>
                      <div class="bar-wrap">
                        <div class="bar-fill-table" style={"width:" + Math.min(100, pct * 3).toFixed(1) + "%"}></div>
                      </div>
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          <p>Sin datos de barrios. La distribución se actualiza anualmente.</p>
        </div>
      )}
    </section>

    <!-- API link -->
    <section class="api-link-section">
      <div class="api-link-bar">
        <div>
          <strong>API de Población</strong>
          <span style="color:var(--text-muted); font-size:0.8125rem; margin-left:0.5rem">Acceso programático a los datos</span>
        </div>
        <a href="/docs" class="btn btn-secondary btn-sm">Ver docs →</a>
      </div>
    </section>
    </>
    )}
  </div>
</Layout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .page-header h1 { margin: 0.75rem 0 0.4rem; }
  .page-header p { font-size: 0.9375rem; }

  .tier-notice {
    padding: 0.75rem 1rem;
    border: 1px dashed var(--amber-dim);
    border-radius: var(--radius-sm);
    margin-bottom: 2.5rem;
    background: var(--amber-faint);
  }
  .tier-notice p { font-size: 0.8125rem; color: var(--text-dim); }
  .tier-notice a { color: var(--amber); text-decoration: underline; }

  .data-section { margin-bottom: 3rem; }
  .data-section > .label { display: block; margin-bottom: 1rem; }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stat-cell {
    padding: 1.25rem;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .stat-cell:last-child { border-right: none; }

  .stat-label { font-size: 0.5625rem; color: var(--text-muted); letter-spacing: 0.06em; }
  .stat-value { font-size: 1.75rem; font-weight: 500; color: var(--text); line-height: 1; }
  .stat-sub   { font-size: 0.6875rem; color: var(--text-muted); }

  .chart-card {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.25rem;
    position: relative;
  }

  .bar-wrap { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
  .bar-fill-table {
    height: 100%;
    background: var(--accent);
    opacity: 0.6;
    border-radius: 3px;
    min-width: 2px;
    transition: width 0.3s ease;
  }

  .empty-state {
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .empty-state p { font-size: 0.875rem; color: var(--text-muted); }

  .api-link-section { margin-bottom: 2rem; }
  .api-link-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    flex-wrap: wrap;
  }
  .api-link-bar strong { font-size: 0.875rem; }

  @media (max-width: 768px) {
    .page-header { flex-direction: column; gap: 1rem; }
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(2) { border-right: none; }
    .stat-cell:nth-child(1), .stat-cell:nth-child(2) { border-bottom: 1px solid var(--border); }
    .api-link-bar { flex-direction: column; align-items: flex-start; }
    .chart-card canvas { height: 300px !important; }
  }
  @media (max-width: 480px) {
    .stats-row { grid-template-columns: 1fr; }
    .stat-cell { border-right: none; border-bottom: 1px solid var(--border); }
    .stat-cell:last-child { border-bottom: none; }
    .chart-card canvas { height: 240px !important; }
  }
</style>
