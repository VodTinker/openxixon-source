---
interface Props {
  message: string
  submessage?: string
}
const { message, submessage } = Astro.props
---

<div class="empty-state">
  <p class="empty-state-main mono">{message}</p>
  {submessage && <p class="empty-state-sub mono">{submessage}</p>}
</div>

<style>
  .empty-state {
    padding: 2rem 1.25rem;
    border: 1px dashed var(--border);
    background: var(--surface);
    text-align: center;
  }
  .empty-state-main {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin: 0;
    letter-spacing: 0.04em;
  }
  .empty-state-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0.5rem 0 0;
    letter-spacing: 0.02em;
  }
</style>
